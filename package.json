{
  "name": "lastbench",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @lastbench/api exec prisma generate",
    "db:migrate": "pnpm --filter @lastbench/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @lastbench/api exec prisma db seed",
    "db:studio": "pnpm --filter @lastbench/api exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  }
}
