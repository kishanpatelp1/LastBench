generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MODERATOR
  ADMIN
}

enum PostType {
  TEXT
  IMAGE
  POLL
  LINK
}

enum VoteType {
  UP
  DOWN
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  COMMENT
  REPLY
  VOTE
  MENTION
  SYSTEM
  COMMUNITY
}

// ─── Auth ──────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  displayName   String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified        Boolean  @default(false)
  onboardingCompleted  Boolean  @default(false)
  role                 Role     @default(STUDENT)
  branch               String?
  year                 Int?
  bio                  String?
  isBanned             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // H-1: Email verification fields
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?

  // H-2: Password reset fields
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  posts          Post[]
  comments       Comment[]
  votes          Vote[]
  reports        Report[]        @relation("reporter")
  reportedItems  Report[]        @relation("reported_user")
  notifications  Notification[]  @relation("recipient")
  memberships    CommunityMember[]
  pollVotes      PollVote[]

  @@index([email])
  @@index([username])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt]) // C-2: Index for efficient expired session cleanup
}

model OAuthAccount {
  id         String @id @default(cuid())
  userId     String
  provider   String
  providerId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

// ─── Communities ───────────────────────────────────
// Note: GIN trigram indexes exist on name and description via raw SQL migration (won't show in prisma db pull diffs)
model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  avatarUrl   String?
  bannerUrl   String?
  isDefault   Boolean  @default(false)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts   Post[]
  members CommunityMember[]
  rules   CommunityRule[]

  @@index([slug])
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model CommunityRule {
  id          String    @id @default(cuid())
  communityId String
  title       String
  description String?
  orderNum    Int       @default(0)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

// ─── Posts ─────────────────────────────────────────
// Note: GIN trigram indexes exist on title and content via raw SQL migration (won't show in prisma db pull diffs)
model Post {
  id           String   @id @default(cuid())
  authorId     String
  communityId  String
  title        String?
  content      String
  type         PostType @default(TEXT)
  isAnonymous  Boolean  @default(true)
  mediaUrls    String[]
  tags         String[]
  score        Int      @default(0)
  commentCount Int      @default(0)
  isDeleted    Boolean  @default(false)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  community Community @relation(fields: [communityId], references: [id])
  comments  Comment[]
  votes     Vote[]
  reports   Report[]
  poll      Poll?

  @@index([communityId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([score(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Poll {
  id        String       @id @default(cuid())
  postId    String       @unique
  expiresAt DateTime?

  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options   PollOption[]
  pollVotes PollVote[]   // M-7: back-relation required by PollVote.poll
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  orderNum Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

// M-7: Added pollId to PollVote so we can enforce @@unique([userId, pollId])
model PollVote {
  id       String @id @default(cuid())
  userId   String
  optionId String
  pollId   String // M-7: denormalized pollId for correct unique constraint

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId]) // M-7: prevents voting twice on same poll
}

// ─── Comments ──────────────────────────────────────
model Comment {
  id          String   @id @default(cuid())
  authorId    String
  postId      String
  parentId    String?
  content     String
  isAnonymous Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  score       Int      @default(0)
  depth       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  User      @relation(fields: [authorId], references: [id])
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  votes   Vote[]
  reports Report[]

  @@index([postId, createdAt])
  @@index([parentId])
}

// ─── Votes ─────────────────────────────────────────
model Vote {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  type      VoteType
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

// ─── Reports & Moderation ──────────────────────────
model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     String?
  commentId  String?
  userId     String?
  reason     String
  details    String?
  status     ReportStatus @default(PENDING)
  aiScore    Float?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter     User     @relation("reporter", fields: [reporterId], references: [id])
  reportedUser User?    @relation("reported_user", fields: [userId], references: [id])
  post         Post?    @relation(fields: [postId], references: [id])
  comment      Comment? @relation(fields: [commentId], references: [id])

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ─── Notifications ─────────────────────────────────
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType
  title       String
  body        String?
  data        Json?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([createdAt(sort: Desc)])
}
