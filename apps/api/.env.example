# LastBench API — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit your actual .env to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway: copy from the Railway dashboard)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/lastbench?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL (Railway: copy from Redis plugin dashboard)
REDIS_URL="redis://localhost:6380"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development       # development | production | test
LOG_LEVEL=debug            # trace | debug | info | warn | error | fatal

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend application (no trailing slash)
CORS_ORIGIN="http://localhost:3000"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random secret, minimum 32 characters. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-string"
# Public URL of this API server (used in email links)
BETTER_AUTH_URL="http://localhost:3001"

# ─── OAuth (optional) ────────────────────────────────────────────────────────
# Google OAuth — create at https://console.cloud.google.com
# Steps: APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GOOGLE_CALLBACK_URL must route through your FRONTEND proxy, NOT directly to the API.
# This ensures the session cookie is set on the frontend domain, not the API domain.
# ⚠️  Dev:  http://localhost:3000/api/auth/google/callback
# ⚠️  Prod: https://<your-vercel-domain>/api/auth/google/callback
# Add whichever URL(s) you use here to your Google Console "Authorized redirect URIs".
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# The public URL of your frontend — used to redirect users after OAuth completes.
# Dev:  http://localhost:3000
# Prod: https://<your-vercel-domain>
FRONTEND_URL="http://localhost:3000"

# GitHub OAuth — create at https://github.com/settings/apps
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Local directory for uploaded files (relative to apps/api)
UPLOAD_DIR="./uploads"
# Max upload size in bytes (default: 50 MB, supports short videos)
MAX_FILE_SIZE=52428800

# ─── Email (SMTP / Nodemailer for 100% Free Production Delivery) ─────────────
# 1. Enable 2-Step Verification on your Gmail account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ─── Email (Resend Fallback) ──────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="LastBench <onboarding@resend.dev>"

# ─── AI Moderation (optional) ────────────────────────────────────────────────
OPENAI_API_KEY=""
