{
  "extends": "@lastbench/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lastbench/shared": ["../../packages/shared/src"],
      "@lastbench/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src", "vite-env.d.ts"]
}
